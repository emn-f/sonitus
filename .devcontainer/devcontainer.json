{
  "name": "Sonitus",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Sonitus",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "corepack enable && pnpm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
